---
import '../styles/global.css';
import { content } from '../data/content';
import { languages } from '../i18n/ui';
import { getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';
import { THEME_INIT } from '../lib/theme-init.mjs';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const c = content[lang];

const canonical = new URL(Astro.url.pathname, Astro.site);

// Strip any locale prefix so hreflang mapping works from every page.
const bare = Astro.url.pathname.replace(/^\/(es)(?=\/|$)/, '') || '/';
const normalized = bare.endsWith('/') && bare !== '/' ? bare.slice(0, -1) : bare;

const alternates = (Object.keys(languages) as Array<keyof typeof languages>).map((l) => ({
  lang: l,
  href: new URL(localizePath(normalized, l), Astro.site).toString(),
}));

const nav = [
  { key: 'nav.about', path: '/about' },
  { key: 'nav.experience', path: '/experience' },
  { key: 'nav.projects', path: '/projects' },
  { key: 'nav.recommendations', path: '/recommendations' },
  { key: 'nav.contact', path: '/contact' },
  // In the nav for review. It may end up as a footer link instead — six items
  // is already the comfortable maximum.
  { key: 'nav.security', path: '/security' },
] as const;

const other = (Object.keys(languages) as Array<keyof typeof languages>).find((l) => l !== lang);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(normalized, Astro.site).toString()} />

    <!-- Runs before first paint so a stored theme never flashes the wrong one.
         Its CSP hash is derived from the same constant in astro.config.mjs. -->
    <script is:inline set:html={THEME_INIT} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
  </head>

  <body>
    <a href="#main" class="skip">Skip to content</a>
    <div class="wrap">
      <header class="site-header">
        <a class="mark" href={localizePath('/', lang)} aria-label="Home">DB</a>
        <div class="header-right">
          <nav class="nav" aria-label="Primary">
            {
              nav.map((item) => {
                const href = localizePath(item.path, lang);
                const current = normalized === item.path;
                return (
                  <a href={href} aria-current={current ? 'page' : undefined}>
                    {t(item.key)}
                  </a>
                );
              })
            }
          </nav>

          <button type="button" class="theme-toggle" data-theme-toggle aria-label={t('theme.toggle')}>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
            </svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          </button>
        </div>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="site-footer">
        <span>{c.footer.rights}</span>
        <span>
          {other && <a href={localizePath(normalized, other)}>{languages[other]}</a>}
        </span>
      </footer>
    </div>

    <script>
      // --- avatar: tilt toward the pointer -----------------------------------
      const avatar = document.querySelector('[data-avatar]');
      const inner = avatar?.querySelector<HTMLElement>('.avatar-img');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (avatar && inner && !reduced.matches) {
        const MAX = 9; // degrees; beyond this it stops reading as a tilt
        let queued = false;
        let lastX = 0;
        let lastY = 0;
        const apply = () => {
          queued = false;
          const box = avatar.getBoundingClientRect();
          const cx = box.left + box.width / 2;
          const cy = box.top + box.height / 2;
          // Normalise over roughly three avatar-widths of travel so the tilt
          // responds to the whole viewport rather than only a near hover.
          const nx = Math.max(-1, Math.min(1, (lastX - cx) / (box.width * 3)));
          const ny = Math.max(-1, Math.min(1, (lastY - cy) / (box.height * 3)));
          inner.style.setProperty('--ry', `${(nx * MAX).toFixed(2)}deg`);
          inner.style.setProperty('--rx', `${(-ny * MAX).toFixed(2)}deg`);
        };
        window.addEventListener(
          'pointermove',
          (e) => {
            lastX = e.clientX;
            lastY = e.clientY;
            if (!queued) {
              queued = true;
              requestAnimationFrame(apply);
            }
          },
          { passive: true },
        );
      }

      // --- experience timeline: draw in when scrolled to ----------------------
      const roles = document.querySelector('.roles[data-animate]');
      if (roles) {
        if (reduced.matches || !('IntersectionObserver' in window)) {
          roles.classList.add('is-visible');
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.15 },
          );
          io.observe(roles);
        }
      }

      // --- live audit: report what this page actually is ----------------------
      const liveAudit = document.querySelector('[data-live-audit]');
      if (liveAudit) {
        const set = (key: string, text: string) => {
          const el = liveAudit.querySelector(`[data-live="${key}"]`);
          if (el) el.textContent = text;
        };

        // Read this page's own CSP out of the document it was served with.
        const meta = document.querySelector('meta[http-equiv="content-security-policy" i]');
        const csp = meta?.getAttribute('content') ?? '';
        const hashes = csp.match(/'sha\d{3}-[^']+'/g) ?? [];
        set('csp', hashes.length ? `${hashes.length} inline scripts/styles hashed` : 'none found');

        // Count the external scripts the browser was actually asked to fetch.
        const external = document.querySelectorAll('script[src]');
        set('js', external.length === 0 ? '0 files' : `${external.length} file(s)`);

        // Ask the server for this very page and read back the headers it sets.
        fetch(window.location.href, { method: 'HEAD' })
          .then((res) => {
            const wanted = [
              'strict-transport-security',
              'x-content-type-options',
              'referrer-policy',
              'permissions-policy',
              'content-security-policy',
            ];
            const present = wanted.filter((h) => res.headers.get(h));
            set(
              'headers',
              present.length
                ? `${present.length}/${wanted.length} present`
                : 'none (dev server — set by Cloudflare in production)',
            );
          })
          .catch(() => set('headers', 'could not be read'));
      }

      // --- spotter ------------------------------------------------------------
      const rounds = document.querySelectorAll('[data-round]');
      if (rounds.length) {
        const scoreEl = document.querySelector('[data-score]');
        let score = 0;
        let answered = 0;
        for (const round of rounds) {
          const answer = Number(round.getAttribute('data-answer'));
          const list = round.querySelector('.code');
          const reveal = round.querySelector('[data-reveal]');
          const verdict = round.querySelector('[data-verdict]');
          for (const btn of round.querySelectorAll('.code-line')) {
            btn.addEventListener('click', () => {
              if (list?.hasAttribute('data-done')) return;
              list?.setAttribute('data-done', '');
              const picked = Number(btn.getAttribute('data-line'));
              const right = picked === answer;
              if (right) score += 1;
              answered += 1;
              btn.setAttribute('data-state', right ? 'right' : 'wrong');
              if (!right) {
                const correct = round.querySelector(`.code-line[data-line="${answer}"]`);
                correct?.setAttribute('data-state', 'right');
              }
              if (verdict) {
                verdict.textContent = right
                  ? document.documentElement.lang === 'es'
                    ? 'Correcto.'
                    : 'Correct.'
                  : document.documentElement.lang === 'es'
                    ? 'No exactamente — la línea marcada es la peligrosa.'
                    : 'Not quite — the highlighted line is the dangerous one.';
              }
              reveal?.removeAttribute('hidden');
              if (scoreEl) scoreEl.textContent = `${score}/${rounds.length}`;
              // Nudge the count only once everything has been attempted.
              if (answered === rounds.length && scoreEl) {
                scoreEl.setAttribute('data-complete', '');
              }
            });
          }
        }
      }

      // --- theme toggle -------------------------------------------------------
      const toggle = document.querySelector('[data-theme-toggle]');
      toggle?.addEventListener('click', () => {
        const root = document.documentElement;
        // With no stored choice we are following the OS, so read what it
        // actually resolved to rather than assuming light.
        const current =
          root.dataset.theme ??
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (e) {
          /* storage blocked: the choice still applies for this page view */
        }
      });
    </script>
  </body>
</html>
