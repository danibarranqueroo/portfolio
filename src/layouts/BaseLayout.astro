---
import '../styles/global.css';
import { content } from '../data/content';
import { languages } from '../i18n/ui';
import { getLangFromUrl, localizePath, useTranslations, withSlash } from '../i18n/utils';
import { THEME_INIT } from '../lib/theme-init.mjs';

interface Props {
  title: string;
  description: string;
  /** Keep a page out of search results while its content is still placeholder. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const c = content[lang];

const canonical = new URL(Astro.url.pathname, Astro.site);

// Strip any locale prefix so hreflang mapping works from every page.
const bare = Astro.url.pathname.replace(/^\/(es)(?=\/|$)/, '') || '/';
const normalized = bare.endsWith('/') && bare !== '/' ? bare.slice(0, -1) : bare;

/**
 * Canonical tags and the sitemap use a trailing slash, because that is the URL
 * Astro builds. The hreflang alternates were built from a slash-stripped path,
 * so they disagreed, and a search engine reads /about and /about/ as two URLs.
 */
const alternates = (Object.keys(languages) as Array<keyof typeof languages>).map((l) => ({
  lang: l,
  href: new URL(localizePath(normalized, l), Astro.site).toString(),
}));

const nav = [
  { key: 'nav.about', path: '/about' },
  { key: 'nav.experience', path: '/experience' },
  { key: 'nav.projects', path: '/projects' },
  { key: 'nav.recommendations', path: '/recommendations' },
  { key: 'nav.contact', path: '/contact' },
  // Security is here for review. It may end up as a footer link instead.
  { key: 'nav.security', path: '/security' },
] as const;

const other = (Object.keys(languages) as Array<keyof typeof languages>).find((l) => l !== lang);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(withSlash(normalized), Astro.site).toString()}
    />

    <!-- Runs before first paint so a stored theme never flashes the wrong one.
         Its CSP hash is derived from the same constant in astro.config.mjs. -->
    <script is:inline set:html={THEME_INIT} />

  </head>

  <body>
    <a href="#main" class="skip">Skip to content</a>
    <div class="wrap">
      <header class="site-header" data-header>
        {/*
          One set of markup for both layouts. Below the breakpoint the header
          becomes a three-column grid (menu, mark, theme) and .header-right is
          set to display:contents so its two children join that grid directly,
          which is what lets the nav become a panel without a second copy of
          the links in the DOM.
        */}
        <button
          type="button"
          class="menu-toggle"
          data-menu-toggle
          aria-controls="primary-nav"
          aria-expanded="false"
          aria-label={t('nav.menu')}
        >
          <svg class="icon-bars" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>

        <a class="mark" href={localizePath('/', lang)} aria-label="Home">DB</a>
        <div class="header-right">
          <nav class="nav" id="primary-nav" aria-label="Primary">
            {
              nav.map((item) => {
                const href = localizePath(item.path, lang);
                const current = normalized === item.path;
                return (
                  <a href={href} aria-current={current ? 'page' : undefined}>
                    {t(item.key)}
                  </a>
                );
              })
            }
          </nav>

          <button type="button" class="theme-toggle" data-theme-toggle aria-label={t('theme.toggle')}>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
            </svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          </button>
        </div>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="site-footer">
        <span>{c.footer.rights}</span>
        <span>
          {other && <a href={localizePath(normalized, other)}>{languages[other]}</a>}
        </span>
      </footer>
    </div>

    <script>
      // --- avatar: eyes follow the pointer ------------------------------------
      const avatar = document.querySelector('[data-avatar]');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (avatar && !reduced.matches) {
        const eyes = avatar.querySelectorAll<HTMLElement>('.eye img');
        // Travel is a fraction of the rendered width, so it holds at any size.
        // It is ASYMMETRIC on purpose: in the source the irises already sit
        // left of centre in their openings, so there is less room to look
        // left than right. Past about 2px leftward (at a 240px avatar) the
        // sclera balloons and the circular window starts clipping the iris,
        // which is the "the whites look strange" bug. Measured by sweeping
        // the value and rendering each step.
        const TRAVEL_LEFT = 0.0075;
        const TRAVEL_RIGHT = 0.0135;
        const TRAVEL_Y = 0.0075;
        let queued = false;
        let lastX = 0;
        let lastY = 0;
        const apply = () => {
          queued = false;
          const box = avatar.getBoundingClientRect();
          if (!box.width) return;
          // Track from the eyes, not the middle of the picture, or the gaze
          // reads as slightly off whenever the pointer is level with them.
          const cx = box.left + box.width * 0.49;
          const cy = box.top + box.height * 0.435;
          // Normalise over roughly two avatar-widths of travel so the eyes
          // respond across the viewport rather than only very near the face.
          const nx = Math.max(-1, Math.min(1, (lastX - cx) / (box.width * 2)));
          const ny = Math.max(-1, Math.min(1, (lastY - cy) / (box.height * 2)));
          const ex = nx * box.width * (nx < 0 ? TRAVEL_LEFT : TRAVEL_RIGHT);
          // Vertical stays tight either way: the lid crops the iris sooner
          // going up and down than the corners do going sideways.
          const ey = ny * box.width * TRAVEL_Y;
          for (const eye of eyes) {
            eye.style.setProperty('--ex', `${ex.toFixed(2)}px`);
            eye.style.setProperty('--ey', `${ey.toFixed(2)}px`);
          }
        };
        window.addEventListener(
          'pointermove',
          (e) => {
            lastX = e.clientX;
            lastY = e.clientY;
            if (!queued) {
              queued = true;
              requestAnimationFrame(apply);
            }
          },
          { passive: true },
        );
      }

      // --- mobile menu --------------------------------------------------------
      // The panel exists in the markup at every width; CSS decides whether it
      // is a row of links or a dropdown. This only manages the open state, so
      // resizing to desktop while open leaves nothing stranded: the desktop
      // rules never look at [data-open].
      const header = document.querySelector('[data-header]');
      const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      if (header && menuBtn) {
        const setOpen = (open: boolean) => {
          header.toggleAttribute('data-open', open);
          menuBtn.setAttribute('aria-expanded', String(open));
        };

        menuBtn.addEventListener('click', () => {
          setOpen(!header.hasAttribute('data-open'));
        });

        // Escape closes and hands focus back, otherwise a keyboard user is
        // left pointing at a panel that is no longer there.
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && header.hasAttribute('data-open')) {
            setOpen(false);
            menuBtn.focus();
          }
        });

        // A tap anywhere outside closes it. Clicks on a link inside navigate
        // away anyway, but closing first avoids the panel flashing on pages
        // served from the back/forward cache.
        document.addEventListener('click', (event) => {
          if (!header.hasAttribute('data-open')) return;
          const target = event.target as Node;
          if (!header.contains(target)) setOpen(false);
        });

        for (const link of document.querySelectorAll('#primary-nav a')) {
          link.addEventListener('click', () => setOpen(false));
        }
      }

      // --- experience timeline: draw in when scrolled to ----------------------
      const roles = document.querySelector('.roles[data-animate]');
      if (roles) {
        if (reduced.matches || !('IntersectionObserver' in window)) {
          roles.classList.add('is-visible');
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.15 },
          );
          io.observe(roles);
        }
      }

      // --- recommendations: each quote drifts in as it is reached -------------
      // Observed one by one rather than as a group, so the reveal follows the
      // reader down the page instead of firing the whole set at the first
      // card. Each one is unobserved after it lands: they stay visible, and
      // by the bottom the full stack is readable at once.
      const clouds = document.querySelectorAll('[data-cloud]');
      if (clouds.length) {
        if (reduced.matches || !('IntersectionObserver' in window)) {
          for (const cloud of clouds) cloud.classList.add('is-visible');
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              }
            },
            // A low threshold with a bottom margin, so a card is already in
            // place by the time it is comfortably on screen rather than
            // animating under the reader's eyes.
            { threshold: 0.1, rootMargin: '0px 0px -28% 0px' },
          );
          for (const cloud of clouds) io.observe(cloud);
        }
      }

      // --- live audit: report what this page actually is ----------------------
      const liveAudit = document.querySelector('[data-live-audit]');
      if (liveAudit) {
        const set = (key: string, text: string) => {
          const el = liveAudit.querySelector(`[data-live="${key}"]`);
          if (el) el.textContent = text;
        };

        // Read this page's own CSP out of the document it was served with.
        const meta = document.querySelector('meta[http-equiv="content-security-policy" i]');
        const csp = meta?.getAttribute('content') ?? '';
        const hashes = csp.match(/'sha\d{3}-[^']+'/g) ?? [];
        set('csp', hashes.length ? `${hashes.length} inline scripts/styles hashed` : 'none found');

        // Count the external scripts the browser was actually asked to fetch.
        const external = document.querySelectorAll('script[src]');
        set('js', external.length === 0 ? '0 files' : `${external.length} file(s)`);

        // Ask the server for this very page and read back the headers it sets.
        fetch(window.location.href, { method: 'HEAD' })
          .then((res) => {
            const wanted = [
              'strict-transport-security',
              'x-content-type-options',
              'referrer-policy',
              'permissions-policy',
              'content-security-policy',
            ];
            const present = wanted.filter((h) => res.headers.get(h));
            set(
              'headers',
              present.length
                ? `${present.length}/${wanted.length} present`
                : 'none (dev server, set by Cloudflare in production)',
            );
          })
          .catch(() => set('headers', 'could not be read'));
      }

      // --- spotter ------------------------------------------------------------
      const rounds = document.querySelectorAll('[data-round]');
      if (rounds.length) {
        const scoreEl = document.querySelector('[data-score]');
        let score = 0;
        let answered = 0;
        for (const round of rounds) {
          const answer = Number(round.getAttribute('data-answer'));
          const list = round.querySelector('.code');
          const reveal = round.querySelector('[data-reveal]');
          const verdict = round.querySelector('[data-verdict]');
          for (const btn of round.querySelectorAll('.code-line')) {
            btn.addEventListener('click', () => {
              if (list?.hasAttribute('data-done')) return;
              list?.setAttribute('data-done', '');
              const picked = Number(btn.getAttribute('data-line'));
              const right = picked === answer;
              if (right) score += 1;
              answered += 1;
              btn.setAttribute('data-state', right ? 'right' : 'wrong');
              if (!right) {
                const correct = round.querySelector(`.code-line[data-line="${answer}"]`);
                correct?.setAttribute('data-state', 'right');
              }
              if (verdict) {
                verdict.textContent = right
                  ? document.documentElement.lang === 'es'
                    ? 'Correcto.'
                    : 'Correct.'
                  : document.documentElement.lang === 'es'
                    ? 'Casi. La línea marcada es la peligrosa.'
                    : 'Not quite, the highlighted line is the dangerous one.';
              }
              reveal?.removeAttribute('hidden');
              if (scoreEl) scoreEl.textContent = `${score}/${rounds.length}`;
              // Nudge the count only once everything has been attempted.
              if (answered === rounds.length && scoreEl) {
                scoreEl.setAttribute('data-complete', '');
              }
            });
          }
        }
      }


      // --- theme toggle -------------------------------------------------------
      const toggle = document.querySelector('[data-theme-toggle]');
      toggle?.addEventListener('click', () => {
        const root = document.documentElement;
        // With no stored choice we are following the OS, so read what it
        // actually resolved to rather than assuming light.
        const current =
          root.dataset.theme ??
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (e) {
          /* storage blocked: the choice still applies for this page view */
        }
      });
    </script>
  </body>
</html>
