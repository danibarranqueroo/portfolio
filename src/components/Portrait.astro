---
import { getImage } from 'astro:assets';
import avatarSrc from '../assets/avatar.png';

/**
 * Avatar cutout whose eyes follow the pointer.
 *
 * The image is a raster, so the painted pupils cannot be moved. Overlaying
 * synthetic eyes looks pasted-on — these eyes are heavily stylised, with a
 * lash line, lid shadow and a specific gloss highlight that would have to be
 * faked exactly.
 *
 * Instead each eye is a small circular window holding a SECOND copy of the
 * same image, aligned so the iris sits in the window. Shifting that copy a
 * couple of pixels moves the iris while the surrounding face stays put, and
 * because the pixels come from the original the colour and shading match
 * perfectly. Real sclera slides in on the trailing side, which is exactly
 * what an eye movement looks like.
 *
 * Geometry comes from measuring the source (375x666): iris centres at
 * (134, 290) and (252, 290), radius ~17. All positions are percentages so it
 * holds at any rendered size.
 *
 * getImage() rather than three <Image> tags so every copy points at one
 * asset: the browser fetches it once.
 */
const avatar = await getImage({ src: avatarSrc, format: 'webp' });
const { src, attributes } = avatar;
const dims = { width: attributes.width, height: attributes.height };
---

<div class="avatar" data-avatar aria-hidden="true">
  <img class="avatar-img" src={src} alt="" {...dims} loading="eager" fetchpriority="high" />

  <span class="eye eye-l">
    <img src={src} alt="" {...dims} aria-hidden="true" />
  </span>
  <span class="eye eye-r">
    <img src={src} alt="" {...dims} aria-hidden="true" />
  </span>
</div>
