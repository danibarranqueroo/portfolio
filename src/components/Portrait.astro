---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';

/**
 * Free-standing avatar cutout with a perspective tilt.
 *
 * The source is a background-removed PNG, so there is no frame, circle or
 * crop — the silhouette is the shape. astro:assets re-encodes it to WebP at
 * build time (sharp), which takes it from ~300 KB to a fraction of that while
 * keeping the alpha channel; a plain <img> would have shipped the raw PNG.
 *
 * A real WebGL model was considered and rejected: the asset cannot be derived
 * from one image here, and three.js is ~150 KB gzipped against a 2.5 KB JS
 * budget. See docs/DECISIONS.md.
 *
 * Under prefers-reduced-motion the tilt is inert and it renders flat.
 */
---

<div class="avatar" data-avatar aria-hidden="true">
  <Image
    class="avatar-img"
    src={avatar}
    alt=""
    widths={[240, 480]}
    sizes="(max-width: 520px) 150px, 240px"
    format="webp"
    loading="eager"
    fetchpriority="high"
  />
</div>
