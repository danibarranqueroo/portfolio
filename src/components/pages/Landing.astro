---
import { content } from '../../data/content';
import type { Lang } from '../../i18n/ui';
import { localizePath } from '../../i18n/utils';
import Portrait from '../Portrait.astro';

const { lang } = Astro.props as { lang: Lang };
const c = content[lang].landing;
const links = content[lang].links;
---
<section class="wide">
  <div class="hero">
    <div class="hero-text">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1 class="display" set:html={c.title.replace('\n', '<br />')} />
    </div>
    <Portrait />
  </div>
  <p class="lede">{c.lede}</p>
  <div class="links">
    <a class="btn" href={localizePath('/cv', lang)}>{c.cta}</a>
    <a class="lnk" href={links.github} rel="me noopener" target="_blank">GitHub</a>
    <a class="lnk" href={links.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
    <a class="lnk" href={links.email}>Email</a>
  </div>
</section>

<section class="wide">
  <h2 class="sect">{lang === 'es' ? 'Ahora mismo' : 'Currently'}</h2>
  <ul class="rows">
    {c.now.map((r) => (
      <li class="row"><span class="row-k">{r.k}</span><span class="row-v">{r.v}</span></li>
    ))}
  </ul>
</section>

{c.note && <p class="note">{c.note}</p>}
