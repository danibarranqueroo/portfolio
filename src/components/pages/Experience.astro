---
import { content } from '../../data/content';
import type { Lang } from '../../i18n/ui';

const { lang } = Astro.props as { lang: Lang };
const c = content[lang].experience;
---
<section>
  <p class="eyebrow">{c.eyebrow}</p>
  <h1 class="display display-sm" set:html={c.title.replace('\n', '<br />')} />
  <p class="lede">{c.lede}</p>
</section>

<section style="margin-top: 56px;">
  <h2 class="sect">{lang === 'es' ? 'Puestos' : 'Roles'}</h2>
  <div class="roles" data-animate>
    {c.roles.map((role) => (
      <article class="role">
        <div class="spine" />
        <div class="role-body">
          <div>
            <h3 class="role-co">{role.company}</h3>
            <p class="role-meta">{role.meta}</p>
          </div>
          <ul class="impacts">
            {role.impacts.map((i) => (
              <li class="impact">
                <span class="metric">{i.metric}</span>
                <span class="impact-t">{i.text}</span>
              </li>
            ))}
          </ul>
          <div class="tags">
            {role.tags.map((tg) => <span class="tag">{tg}</span>)}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<section style="margin-top: 56px;">
  <h2 class="sect">Open source</h2>
  <ul class="rows">
    {c.oss.map((r) => (
      <li class="row"><span class="row-k">{r.k}</span><span class="row-v">{r.v}</span></li>
    ))}
  </ul>
</section>

<p class="note" style="margin-top: 56px;">{c.note}</p>
