---
import { content } from '../../data/content';
import type { Lang } from '../../i18n/ui';

/**
 * A one-page CV, laid out after the NIT Warangal Overleaf template Dani chose:
 * single column, serif, small-caps section heads over a rule, title left with
 * dates right, italic subtitle, tight bullets.
 *
 * It is CSS rather than LaTeX, so it is a reproduction of that structure, not
 * the template itself. Computer Modern is not available, so the site's serif
 * carries the same role.
 *
 * Content comes from content.cv, which is written short on purpose. See the
 * note on CvContent for why it is not derived from the site copy.
 */
const { lang } = Astro.props as { lang: Lang };
const es = lang === 'es';
const c = content[lang];
const cv = c.cv;
const links = c.links;

const t = {
  education: es ? 'Formación' : 'Education',
  experience: es ? 'Experiencia' : 'Experience',
  projects: es ? 'Proyectos' : 'Projects',
  skills: es ? 'Competencias técnicas' : 'Technical skills',
  achievements: es ? 'Otros' : 'Achievements',
  print: es ? 'Descargar en PDF' : 'Download as PDF',
  hint: es
    ? 'Se abre el diálogo de impresión, elige «Guardar como PDF».'
    : 'Opens the print dialog, then choose “Save as PDF”.',
};
---

<article class="cv">
  <header class="cv-head">
    <h1 class="cv-name">Daniel Barranquero</h1>
    <p class="cv-role">{cv.role}</p>
    <p class="cv-contact">
      <a href={links.email}>josedanielbarranqueroortigosa@gmail.com</a>
      <span class="cv-sep" aria-hidden="true">·</span>
      <a href={links.github} rel="me noopener">github.com/danibarranqueroo</a>
      <span class="cv-sep" aria-hidden="true">·</span>
      <a href={links.linkedin} rel="me noopener">linkedin.com/in/danibarranquero</a>
      <span class="cv-sep" aria-hidden="true">·</span>
      <span>{cv.location}</span>
    </p>
  </header>

  <div class="cv-actions no-print">
    <button type="button" class="btn" data-print>{t.print}</button>
    <span class="lnk">{t.hint}</span>
  </div>


  {
    (
      [
        [t.education, cv.education],
        [t.experience, cv.experience],
        [t.projects, cv.projects],
      ] as const
    ).map(([heading, entries]) => (
      <section class="cv-block">
        <h2 class="cv-sect">{heading}</h2>
        {entries.map((e) => (
          <div class="cv-entry">
            <div class="cv-entry-top">
              <h3 class="cv-entry-title">{e.title}</h3>
              {e.dates && <span class="cv-entry-dates">{e.dates}</span>}
            </div>
            {e.meta && <p class="cv-entry-meta">{e.meta}</p>}
            {e.bullets && (
              <ul class="cv-bullets">
                {e.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </section>
    ))
  }

  <section class="cv-block">
    <h2 class="cv-sect">{t.skills}</h2>
    <ul class="cv-skills">
      {
        cv.skills.map((sk) => (
          <li>
            <span class="cv-skill-k">{sk.k}</span>
            <span class="cv-skill-v">{sk.v}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="cv-block">
    <h2 class="cv-sect">{t.achievements}</h2>
    <ul class="cv-bullets">
      {cv.achievements.map((a) => <li>{a}</li>)}
    </ul>
  </section>
</article>
