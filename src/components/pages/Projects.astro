---
import { content } from '../../data/content';
import type { Lang } from '../../i18n/ui';

const { lang } = Astro.props as { lang: Lang };
const c = content[lang].projects;
---
<section>
  <p class="eyebrow">{c.eyebrow}</p>
  <h1 class="display display-sm" set:html={c.title.replace('\n', '<br />')} />
  <p class="lede">{c.lede}</p>
</section>

<section class="wide">
  <ul class="rows">
    {
      c.items.map((r) => (
        <li class="row">
          <span class="row-k">{r.k}</span>
          <span class="row-v">
            {r.v}
            {/*
              `rel="noopener"` without `me`: the `me` token claims the target is
              another profile of the same person, which is true of the GitHub
              and LinkedIn links elsewhere on this site and is not true of a
              repository.
            */}
            {r.repo && (
              <a class="row-repo" href={r.repo} rel="noopener">
                {r.repo.replace('https://', '')}
              </a>
            )}
          </span>
        </li>
      ))
    }
  </ul>
</section>

{c.note && <p class="note">{c.note}</p>}
