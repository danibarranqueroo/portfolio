---
import { content } from '../../data/content';
import type { Lang } from '../../i18n/ui';

const { lang } = Astro.props as { lang: Lang };
const c = content[lang].projects;
---
<section>
  <p class="eyebrow">{c.eyebrow}</p>
  <h1 class="display display-sm" set:html={c.title.replace('\n', '<br />')} />
  <p class="lede">{c.lede}</p>
</section>

<section class="wide">
  <ul class="rows">
    {
      c.items.map((r) => (
        <li class="row">
          {/*
            The title carries the link when there is a repository, rather than
            a visible URL under the description. `rel="noopener"` without `me`:
            the `me` token claims the target is another profile of the same
            person, which is true of the GitHub and LinkedIn links elsewhere on
            this site and is not true of a repository.
          */}
          <span class="row-k">
            {r.repo ? (
              <a class="row-k-link" href={r.repo} rel="noopener">
                {r.k}
              </a>
            ) : (
              r.k
            )}
          </span>
          <span class="row-v">{r.v}</span>
        </li>
      ))
    }
  </ul>
</section>

{c.note && <p class="note">{c.note}</p>}
