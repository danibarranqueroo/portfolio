---
import { rounds } from '../../data/spotter';
import type { Lang } from '../../i18n/ui';
import { audit } from '../../lib/audit.mjs';
import {
  combinedTotals,
  type Finding,
  loadScans,
  type SecurityScan,
  type Severity,
} from '../../lib/security-scan';

const { lang } = Astro.props as { lang: Lang };
const es = lang === 'es';
const set = rounds[lang];

const scans = loadScans();
const totals = combinedTotals(scans);

const dispositionLabel = {
  blocked: es ? 'bloqueado' : 'blocked',
  accepted: es ? 'riesgo asumido' : 'accepted risk',
  todo: es ? 'pendiente' : 'to do',
};
const severityLabel: Record<Severity, string> = {
  Critical: es ? 'crítica' : 'critical',
  High: es ? 'alta' : 'high',
  Medium: es ? 'media' : 'medium',
  Low: es ? 'baja' : 'low',
  Informational: es ? 'informativa' : 'info',
};

/** Proper nouns, so the same in both locales. */
const providerLabel: Record<string, string> = {
  github: 'GitHub',
  cloudflare: 'Cloudflare',
};

/** What each provider's scan actually looks at, said once per block. */
const providerBlurb: Record<string, string> = es
  ? {
      github:
        'Audita la configuración de este mismo repositorio: protección de rama, permisos de los workflows, escaneo de secretos y avisos de dependencias.',
      cloudflare:
        'Audita la cuenta y la zona DNS desde la que se sirve esta página: TLS, HSTS, DNSSEC, registros de correo y reglas del WAF.',
    }
  : {
      github:
        'Audits this repository’s own configuration: branch protection, workflow permissions, secret scanning and dependency alerts.',
      cloudflare:
        'Audits the account and DNS zone this page is served from: TLS, HSTS, DNSSEC, mail records and WAF rules.',
    };

const byStatus = (scan: SecurityScan, status: string): Finding[] =>
  scan.findings.filter((f) => f.status === status);

const sig =
  audit.signature === 'G'
    ? es
      ? 'válida'
      : 'valid'
    : audit.signature === 'U'
      ? es
        ? 'sin confianza'
        : 'untrusted'
      : es
        ? 'ninguna'
        : 'none';

const facts = [
  { k: es ? 'Commit' : 'Commit', v: audit.commit, mono: true },
  { k: es ? 'Firma' : 'Signature', v: sig, good: audit.signature === 'G' },
  { k: es ? 'Build' : 'Built', v: `${audit.builtAt} UTC`, mono: true },
  { k: es ? 'Node' : 'Node', v: audit.node, mono: true },
  { k: 'pnpm', v: audit.pnpm.replace('pnpm@', ''), mono: true },
  { k: es ? 'Dependencias directas' : 'Direct dependencies', v: String(audit.directDeps) },
  { k: es ? 'Total resueltas' : 'Total resolved', v: String(audit.packages) },
  {
    k: es ? 'Versiones sin fijar' : 'Floating ranges',
    v: String(audit.floatingCount),
    good: audit.floatingCount === 0,
  },
  {
    k: es ? 'Cuarentena' : 'Release quarantine',
    v: es ? `${audit.quarantineDays} días` : `${audit.quarantineDays} days`,
  },
  {
    k: es ? 'Scripts permitidos' : 'Build scripts allowed',
    v: audit.allowedBuilds.join(', '),
    mono: true,
  },
  {
    k: es ? 'Actions fijadas por SHA' : 'Actions SHA-pinned',
    v: `${audit.actionsPinned}/${audit.actionsTotal}`,
    good: audit.actionsPinned === audit.actionsTotal,
  },
];
---

<section>
  <p class="eyebrow">{es ? 'Seguridad' : 'Security'}</p>
  <h1 class="display display-sm">{es ? 'Esta página,\nauditada' : 'This page,\naudited'}</h1>
  <p class="lede">
    {es
      ? 'Aquí no hay ni una cifra escrita a mano. Todas salen del lockfile, del package.json, de la política de pnpm, de los workflows o de git, en tiempo de build.'
      : 'None of these numbers are written by hand. Every one is read at build time from the lockfile, the manifest, the pnpm policy, the workflow files or git.'}
  </p>
</section>

<section class="wide">
  <h2 class="sect">{es ? 'En el build' : 'At build time'}</h2>
  <ul class="rows">
    {
      facts.map((f) => (
        <li class="row">
          <span class="row-k">{f.k}</span>
          <span class="row-v">
            <span class={f.mono ? 'val mono' : 'val'} data-good={f.good === true ? '' : undefined}>
              {f.v}
            </span>
          </span>
        </li>
      ))
    }
  </ul>
</section>

<section class="wide">
  <h2 class="sect">{es ? 'En tu navegador, ahora' : 'In your browser, right now'}</h2>
  <ul class="rows" data-live-audit>
    <li class="row">
      <span class="row-k">{es ? 'Hashes CSP' : 'CSP hashes'}</span>
      <span class="row-v"><span class="val mono" data-live="csp">…</span></span>
    </li>
    <li class="row">
      <span class="row-k">{es ? 'JS externo' : 'External JS'}</span>
      <span class="row-v"><span class="val mono" data-live="js">…</span></span>
    </li>
    <li class="row">
      <span class="row-k">{es ? 'Cabeceras' : 'Response headers'}</span>
      <span class="row-v"><span class="val mono" data-live="headers">…</span></span>
    </li>
  </ul>
  <p class="note note-after-list">
    {es
      ? 'Las cabeceras las sirve Cloudflare desde public/_headers, así que en local no aparecen. Es lo esperado, no un fallo.'
      : 'Response headers are served by Cloudflare from public/_headers, so they are absent on the dev server. That is expected, not a failure.'}
  </p>
</section>

<section class="wide">
  <h2 class="sect">{es ? 'Scans de Prowler' : 'Prowler scans'}</h2>

  {
    scans.length === 0 ? (
      <p class="note">
        {es
          ? 'Todavía no hay ningún scan. Se generan en CI antes de cada deploy.'
          : 'No scan has been generated yet. CI produces them before every deploy.'}
      </p>
    ) : (
      <>
        <p class="prose prose-before-checks">
          {es
            ? 'Prowler audita las dos superficies desde las que vive esta página. Los resultados de abajo son reales y sin tocar, del último scan de cada una.'
            : 'Prowler audits the two surfaces this page lives on. The results below are real and unedited, from the most recent scan of each.'}
        </p>

        {scans.length > 1 && (
          <div class="scan-head">
            <div class="scan-score" data-rate={totals.passRate}>
              <span class="scan-rate">{totals.passRate}%</span>
              <span class="scan-rate-k">{es ? 'en verde, en total' : 'passing, overall'}</span>
            </div>
            <ul class="scan-meta">
              <li><span class="row-k">{es ? 'Controles' : 'Controls'}</span> <span class="val mono">{totals.total}</span></li>
              <li><span class="row-k">{es ? 'En verde' : 'Passing'}</span> <span class="val mono" data-good>{totals.pass}</span></li>
              <li><span class="row-k">{es ? 'En rojo' : 'Failing'}</span> <span class="val mono">{totals.fail}</span></li>
              <li><span class="row-k">{es ? 'Superficies' : 'Surfaces'}</span> <span class="val mono">{scans.length}</span></li>
            </ul>
          </div>
        )}

        {scans.map((scan) => (
          <div class="scan-block">
            <h3 class="scan-provider">{providerLabel[scan.provider] ?? scan.provider}</h3>
            <p class="prose prose-before-checks">{providerBlurb[scan.provider] ?? ''}</p>

            <div class="scan-head">
              <div class="scan-score" data-rate={scan.passRate}>
                <span class="scan-rate">{scan.passRate}%</span>
                <span class="scan-rate-k">{es ? 'controles en verde' : 'controls passing'}</span>
              </div>
              <ul class="scan-meta">
                <li><span class="row-k">{es ? 'En verde' : 'Passing'}</span> <span class="val mono" data-good>{scan.pass}</span></li>
                <li><span class="row-k">{es ? 'En rojo' : 'Failing'}</span> <span class="val mono">{scan.fail}</span></li>
                <li><span class="row-k">{es ? 'Objetivo' : 'Target'}</span> <span class="val mono">{scan.target}</span></li>
                <li><span class="row-k">Prowler</span> <span class="val mono">v{scan.prowlerVersion}</span></li>
                <li><span class="row-k">{es ? 'Fecha' : 'Scanned'}</span> <span class="val mono">{scan.generatedAt.slice(0, 10)}</span></li>
              </ul>
            </div>

            {byStatus(scan, 'FAIL').length > 0 && (
              <>
                <h4 class="scan-sub">
                  {es ? 'Lo que falla, y por qué sigue fallando' : 'Failing, and why they are still failing'}
                </h4>
                <ul class="checks">
                  {byStatus(scan, 'FAIL').map((f) => (
                    <li class="check check-fail">
                      <div class="check-top">
                        <span class={`sev sev-${f.severity.toLowerCase()}`}>{severityLabel[f.severity]}</span>
                        <span class="check-title">{f.title}</span>
                      </div>
                      <code class="check-id">{f.id}</code>
                      {f.disposition && (
                        <p class="check-note">
                          <span class={`disp disp-${f.disposition.state}`}>
                            {dispositionLabel[f.disposition.state]}
                          </span>
                          {f.disposition.note}
                        </p>
                      )}
                    </li>
                  ))}
                </ul>
              </>
            )}

            <h4 class="scan-sub">{es ? 'En verde' : 'Passing'}</h4>
            <ul class="checks checks-pass">
              {byStatus(scan, 'PASS').map((f) => (
                <li class="check">
                  <span class="check-tick" aria-hidden="true">✓</span>
                  <span class="check-title">{f.title}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}

        <p class="note note-after-checks">
          {es
            ? 'Nada de esto está escrito a mano: el JSON-OCSF de Prowler se normaliza en el build. Los fallos se muestran tal cual, con su motivo; esconderlos dejaría la página sin sentido.'
            : 'None of this is written by hand: Prowler’s JSON-OCSF is normalized at build time. Failures are shown as they are, with a stated reason, because hiding them would make the page pointless.'}
        </p>
      </>
    )
  }
</section>

<section class="wide">
  <h2 class="sect">{es ? 'Encuentra la mala configuración' : 'Spot the misconfiguration'}</h2>
  <p class="prose prose-before-game">
    {es
      ? 'Tres configuraciones reales. Haz clic en la línea peligrosa de cada una.'
      : 'Three real configurations. Click the dangerous line in each.'}
    <span class="score" data-score>0/{set.length}</span>
  </p>

  <div class="spotters">
    {
      set.map((r) => (
        <article data-round data-answer={r.answer}>
          <h3 class="spotter-h">{r.title}</h3>
          <ol class="code" role="group" aria-label={r.title}>
            {r.lines.map((line, i) => (
              <li>
                <button type="button" class="code-line" data-line={i}>
                  <span class="ln" aria-hidden="true">{i + 1}</span>
                  <code>{line}</code>
                </button>
              </li>
            ))}
          </ol>
          <div class="reveal" data-reveal hidden>
            <p class="reveal-verdict" data-verdict />
            <p class="reveal-why">{r.why}</p>
            <p class="reveal-fix"><span class="fix-k">{es ? 'Solución' : 'Fix'}</span> {r.fix}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
